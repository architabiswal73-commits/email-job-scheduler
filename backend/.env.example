DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_scheduler
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_ENABLED=false
PORT=4000
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=generate-a-long-random-secret
GOOGLE_CLIENT_ID=__FILL_FROM_GOOGLE_CLOUD_CONSOLE__
GOOGLE_CLIENT_SECRET=__FILL_FROM_GOOGLE_CLOUD_CONSOLE__
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
SLACK_CLIENT_ID=__FILL_FROM_SLACK_APP__
SLACK_CLIENT_SECRET=__FILL_FROM_SLACK_APP__
SLACK_REDIRECT_URI=http://localhost:4000/slack/callback
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=50
